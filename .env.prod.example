# 正式環境連線設定（複製成 .env.prod 並填入實際外部 DB/Redis 位址）
# 使用方式: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# 注意: 目前正式 compose 已包含 mysql/redis/memcached 容器；若要改外部服務，請調整 docker-compose.prod.yml

APP_NAME="My New Laravel"
APP_KEY=base64:generate-this-with-php-artisan-key-generate-show
APP_URL=https://your-domain.example
APP_PORT=8000

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_FORWARD_PORT=3307
DB_DATABASE=my_new_laravel
DB_USERNAME=root
DB_PASSWORD=change-this-db-password

SESSION_DRIVER=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_FORWARD_PORT=6380
REDIS_PASSWORD=

MEMCACHED_PORT=11211

REVERB_APP_ID=my-new-laravel
REVERB_APP_KEY=change-this-reverb-key
REVERB_APP_SECRET=change-this-reverb-secret
REVERB_HOST=your-domain.example
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY=${REVERB_APP_KEY}
VITE_REVERB_HOST=${REVERB_HOST}
VITE_REVERB_PORT=${REVERB_PORT}
VITE_REVERB_SCHEME=${REVERB_SCHEME}
