# 正式環境連線設定（複製成 .env.prod 並填入實際外部 DB/Redis 位址）
# 使用方式: docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d
# 注意: 正式環境沒有 mysql/redis 容器，請指向外部服務

DB_HOST=your-db-host
DB_PORT=3306
DB_DATABASE=my_new_laravel
DB_USERNAME=your-db-user
DB_PASSWORD=your-db-password

REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=null
